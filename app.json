{
  "expo": {
    "name": "Woufy",
    "slug": "woufy",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.woufy.player",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "WouFY.no",
        "UISupportsDocumentBrowser": false,
        "NSSpeechRecognitionUsageDescription": "WouFY.no распознаёт вокал в треке (встроенным распознаванием речи iOS), чтобы точно подогнать текст песни под звучание.",
        "LSApplicationQueriesSchemes": [
          "sidestore",
          "altstore"
        ]
      }
    },
    "android": {
      "package": "com.woufy.player",
      "adaptiveIcon": {
        "backgroundColor": "#1A1F24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset"
    ]
  }
}
