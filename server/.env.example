# Порт сервера (Render задаёт PORT автоматически)
PORT=3000

# Опциональный секретный ключ для защиты бэкенда от посторонних
# Должен совпадать с EXPO_PUBLIC_DOWNLOAD_API_KEY в мобильном приложении
API_KEY=

# Провайдер: auto (по умолчанию: VK если задан VK_TOKEN, иначе yt-dlp), vk, ytdlp
MUSIC_PROVIDER=auto

# Токен VK Audio (например, Kate Mobile token) — если указан, используется VK Audio (как в VKMS)
VK_TOKEN=

# User-Agent для VK Audio API (по умолчанию Kate Mobile)
VK_USER_AGENT=KateMobileAndroid/56 lite-460 (Android 4.4.2; SDK 19; x86; unknown Android SDK built for x86; en)
